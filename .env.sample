HOST=0.0.0.0
PORT=8080
OPF_DEVICE=cpu
OPF_OUTPUT_MODE=typed
OPF_CHECKPOINT=

# On-device (WebGPU) inference settings for the /webgpu page.
# Set OPF_CLIENT_ENABLE=false to force every request to use the server model.
OPF_CLIENT_ENABLE=true
# Optional overrides (leave blank to use built-in defaults):
#   OPF_CLIENT_MODEL: a transformers.js-compatible token-classification model id
#   OPF_TRANSFORMERS_URL: custom transformers.js module URL (e.g. a self-hosted copy)
#   OPF_CLIENT_MIN_SCORE: 0-100 device score required for Auto mode to run on-device
OPF_CLIENT_MODEL=
OPF_TRANSFORMERS_URL=
OPF_CLIENT_MIN_SCORE=50
